# --- required ---------------------------------------------------------------
# DATABASE_URL=sqlite:///siem.db             # default: siem.db in the project folder; set only to use PostgreSQL
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password        # dashboard admin, created on first start
ADMIN_TOKEN=put-a-long-random-string-here  # legacy X-Admin-Token header (acts as admin, handy for curl)
LOCAL_UTC_OFFSET_MINUTES=330               # your timezone, used by the off-hours rule (330 = India)

# --- retention / syslog -----------------------------------------------------
RETENTION_DAYS=30
SYSLOG_ENABLED=true
SYSLOG_PORT=5514

# --- optional: enrichment ---------------------------------------------------
GEO_ONLINE_LOOKUP=true                     # free ip-api.com lookups (cached); false = offline only
GEOIP_DB=                                  # path to GeoLite2-City.mmdb (free MaxMind account)
ABUSEIPDB_KEY=                             # free key, 1000 lookups/day; score >= 75 raises alert severity

# --- optional: notifications (all free) --------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_TELEGRAM_MIN=high
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
NOTIFY_EMAIL_MIN=critical

# --- optional: response safety ----------------------------------------------
ALLOWLIST_IPS=                             # comma-separated IPs that must NEVER be auto-blocked (your own PC, gateway)

# --- optional: where run.py listens ------------------------------------------
HOST=127.0.0.1                             # 0.0.0.0 to accept agents from other machines
PORT=8000
# SSL_CERTFILE=cert.pem                    # made by: python make_cert.py <server-ip>   (HTTPS)
# SSL_KEYFILE=key.pem
